# Default text policy: auto-detect text vs binary; normalize text to LF in
# working tree. Prevents CRLF/LF churn from cross-platform tooling.
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicit binary markers (no text conversion or diff)
*.jar binary
*.png binary
*.ogg binary
*.zip binary
*.class binary

# Generated cache files always use LF
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf
